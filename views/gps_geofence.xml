<odoo>
    <record id='gps_geofence_view_form' model='ir.ui.view'>
        <field name="name">gps_geofence.form</field>
        <field name="model">gps_geofence</field>
        <field name="arch" type="xml">
            
            <form string="Geocerca" js_class="geofence_form">
                        <group col="6" string="">
                            <field name="name"/>                                        
                            <field name="color"/>
                            <field name="hidden"/>                            
                        </group>

                        <field name="polygon_coords"/>     
                        <div id="geofence_map"
                                style="width:100%; height:290px; border:1px solid #CCC;">
                        </div>
            </form>

        </field>
    </record>
    <record id='gps_geofence_view_tree' model='ir.ui.view'>
        <field name="name">gps_geofence.tree</field>
        <field name="model">gps_geofence</field>
        <field name="arch" type="xml">
            <tree string="Models">
                <field name="name"/>
            </tree>
        </field>
    </record>
</odoo>
